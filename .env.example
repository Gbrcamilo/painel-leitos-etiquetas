# Conexao Oracle (Soul MV ou outro HIS)
DB_USER=DBAMV
DB_PASSWORD=troque_a_senha
DB_CONNECT_STRING=host:1521/servico
ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_23_0

# Servidor
PORT=3006
REFRESH_MINUTES=1
DEFAULT_SETOR=Internacao

# Persistencia de auditoria/eventos: false = JSON local, true = tabela Oracle
USO_ORACLE_AUDITORIA=false

# Impressoras (rede) - podem ser sobrescritas por leito/setor no painel
PRINTER_DEFAULT_IP=192.168.0.50
PRINTER_DEFAULT_PORT=9100
PRINTER_DEFAULT_MODEL=zebra
# Modelos suportados: zebra (ZPL) | elgin (EPL/ZPL, a maioria das Elgin atuais aceita ZPL)
