# =======================================================
# CONEXAO ORACLE (Soul MV - Hospital CMI / HPRB Betim)
# =======================================================
# Painel de Leitos & Etiquetas: agora usa APENAS Oracle como fonte.
# Se a conexao falhar, a API retorna erro 500 em vez de pacientes fixos.
USE_ORACLE=true
DB_USER=DBAMV
DB_PASSWORD=soulmv
# IMPORTANTE: use o MESMO connect string valido do mapa-dieta-cmi (nao deixe host:1521/servico)
DB_CONNECT_STRING=srv-odax9-2ha-scan:1521/prdmv.betim.pmb
ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_23_0

# Empresa/filial usada no filtro cd_multi_empresa da consulta de leitos
CD_MULTI_EMPRESA=1

# =======================================================
# CONFIGURACOES DO SERVIDOR E SESSAO
# =======================================================
PORT=3011
# Painel em tempo quase real: 1 minuto sugerido
REFRESH_MINUTES=1
DEFAULT_SETOR=Internacao

# Persistencia de auditoria/eventos: false = JSON local, true = tabela Oracle
USO_ORACLE_AUDITORIA=false

# =======================================================
# CONFIGURACOES DE IMPRESSORAS (REDE TCP/IP - ZPL)
# =======================================================
PRINTER_DEFAULT_IP=192.168.0.50
PRINTER_DEFAULT_PORT=9100
PRINTER_DEFAULT_MODEL=zebra
# Modelos suportados: zebra (ZPL) | elgin (EPL/ZPL)
